            "value" : "Your Egg"
          }
        }
      }
    },
    "Dein Handy ist der Löffel. Halte es flach vor dir, so wie du gleich spielen willst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone is the spoon. Hold it flat in front of you, the way you want to play."
          }
        }
      }
    },
    "Dein Kauf wartet auf Bestätigung. Die Münzen kommen, sobald er bestätigt ist." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your purchase is waiting for approval. The coins arrive as soon as it is approved."
          }
        }
      }
    },
    "Deine Bestleistung" : {
