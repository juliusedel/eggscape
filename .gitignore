# The Xcode project is generated from project.yml (`make gen`); never commit it.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/

# Tools built by scripts/bootstrap.sh. A worktree links to the main checkout's copy, and a symlink is no directory for
# git, so the pattern has no trailing slash: it ignores both.
.tools

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/README.md
fastlane/test_output/
fastlane/screenshots/
fastlane/*.ipa
*.ipa
*.dSYM.zip
.bundle/
vendor/bundle/

# macOS
.DS_Store

# Claude Code worktrees and local state
.claude/
