            "state" : "translated",
            "value" : "Up to 4 phones in the same room, no internet needed."
          }
        }
      }
    },
    "Bitte den Host, auf „Raum erstellen“ zu tippen, und bleib in seiner Nähe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the host to tap “Create Room” and stay close by."
          }
        }
      }
    },
    "Bitte versuche es noch einmal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please try again."
          }
        }
