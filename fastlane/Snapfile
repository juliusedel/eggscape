# fastlane snapshot: renders the staged screenshot scenes of EggscapeUITests/ScreenshotTests (`make screenshots`).
# The 6.3" iPhone 18 Pro is the size App Store Connect requires ("iPhone with Dynamic Island (medium display)", 1206 x
# 2622), the 6.9" iPhone 18 Pro Max the large one (1320 x 2868).
devices(["iPhone 18 Pro Max", "iPhone 18 Pro"])
languages(["de-DE", "en-US"])

project("./Eggscape.xcodeproj")
scheme("Eggscape")
only_testing(["EggscapeUITests/ScreenshotTests"])
# Unsigned like every simulator build here, so it works without a development team (see the Makefile).
xcargs("CODE_SIGNING_ALLOWED=NO")
# The screenshots lane renders into the same folder, then turns the PNGs into JPEGs without an alpha channel and moves
# them to fastlane/screenshots, which only ever holds images ready for upload.
output_directory("./.build/snapshot")
clear_previous_screenshots(true)
# Its overview lists the PNGs, which the lane converts and moves.
skip_open_summary(true)
override_status_bar(true)
# One simulator at a time; snapshot shuts down every running simulator before each one.
concurrent_simulators(false)

# EggscapeUITests/SnapshotHelper.swift is our own minimal helper speaking snapshot's file protocol.
skip_helper_version_check(true)
