    "Der Raum ist voll." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The room is full."
          }
        }
      }
    },
    "Die anderen laufen noch. Wenn du als Host gehst, endet das Rennen auch für sie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The others are still running. If you leave as the host, the race ends for them too."
