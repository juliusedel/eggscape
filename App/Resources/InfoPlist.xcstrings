    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Kamera siehst du beim Spielen durch dein Handy hindurch auf den Boden. Eggscape zeigt das Bild nur an und speichert oder sendet es nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the camera you look through your phone at the ground while you play. Eggscape only shows the image and never saves or sends it."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eggscape nutzt dein lokales Netzwerk nur, um mit Handys in deiner Nähe zu spielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eggscape uses your local network only to play with phones nearby."
          }
        }
      }
    }
  },
  "version" : "1.0"
