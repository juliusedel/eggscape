    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Kamera-Modus siehst du durch dein Handy hindurch auf den Boden. Das Bild wird nur angezeigt, nie gespeichert oder gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In camera mode you look through your phone at the ground. The image is only shown, never saved or sent."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eggscape nutzt dein lokales Netzwerk nur, um mit Handys in deiner Nähe zu spielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eggscape uses your local network only to play with phones nearby."
          }
        }
      }
